<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Foodies Restaurant</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }
        
        body {
            background-color: #1a1a1a;
            min-height: 100vh;
            overflow: hidden;
            position: relative;
        }
        
        .background {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            overflow: hidden;
        }
        
        .circle {
            position: absolute;
            border-radius: 50%;
            background: rgba(255, 120, 0, 0.1);
        }
        
        .circle1 {
            width: 500px;
            height: 500px;
            top: -150px;
            left: -150px;
        }
        
        .circle2 {
            width: 600px;
            height: 600px;
            bottom: -200px;
            right: -200px;
        }
        
        .circle3 {
            width: 300px;
            height: 300px;
            top: 50%;
            left: 20%;
        }
        
        .container {
            position: relative;
            z-index: 1;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
        }
        
        .card {
            background: rgba(40, 40, 40, 0.8);
            backdrop-filter: blur(10px);
            border-radius: 20px;
            padding: 60px 40px;
            width: 90%;
            max-width: 800px;
            box-shadow: 0 25px 50px rgba(0, 0, 0, 0.2);
            text-align: center;
            transform: translateY(20px);
            opacity: 0;
            animation: fadeIn 1s forwards;
        }
        
        @keyframes fadeIn {
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        
        h1 {
            font-size: 3.5rem;
            margin-bottom: 20px;
            color: white;
            font-weight: 700;
            position: relative;
            display: inline-block;
        }
        
        h1::after {
            content: '';
            position: absolute;
            bottom: -10px;
            left: 50%;
            transform: translateX(-50%);
            width: 80px;
            height: 4px;
            background: linear-gradient(90deg, #FF5722, #FF9800);
            border-radius: 2px;
        }
        
        .subtitle {
            font-size: 1.5rem;
            margin-bottom: 50px;
            color: #e0e0e0;
            font-weight: 300;
        }
        
        .buttons {
            display: flex;
            justify-content: center;
            gap: 20px;
            flex-wrap: wrap;
        }
        
        .btn {
            padding: 15px 30px;
            min-width: 200px;
            border-radius: 50px;
            font-size: 1.1rem;
            font-weight: 600;
            text-transform: uppercase;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            border: none;
            outline: none;
            text-decoration: none;
        }
        
        .btn-login {
            background: #FF7800;
            color: white;
            box-shadow: 0 6px 15px rgba(255, 120, 0, 0.3);
            animation: glowOrange 3s infinite;
            position: relative;
            overflow: hidden;
        }
        
        .btn-login::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(255, 120, 0, 0.3) 0%, rgba(255, 120, 0, 0) 70%);
            animation: rippleEffect 3s infinite;
            z-index: -1;
        }
        
        .btn-signup {
            background: white;
            color: #333;
            box-shadow: 0 6px 15px rgba(255, 255, 255, 0.2);
            animation: glowWhite 3s infinite;
            position: relative;
            overflow: hidden;
        }
        
        .btn-signup::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(255, 255, 255, 0.3) 0%, rgba(255, 255, 255, 0) 70%);
            animation: rippleEffect 3s infinite 1.5s;
            z-index: -1;
        }
        
        .btn:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);
            animation-play-state: paused;
        }
        
        @keyframes glowOrange {
            0% {
                box-shadow: 0 0 5px rgba(255, 120, 0, 0.5);
            }
            50% {
                box-shadow: 0 0 20px rgba(255, 120, 0, 0.8), 0 0 30px rgba(255, 120, 0, 0.4);
            }
            100% {
                box-shadow: 0 0 5px rgba(255, 120, 0, 0.5);
            }
        }
        
        @keyframes glowWhite {
            0% {
                box-shadow: 0 0 5px rgba(255, 255, 255, 0.3);
            }
            50% {
                box-shadow: 0 0 20px rgba(255, 255, 255, 0.6), 0 0 30px rgba(255, 255, 255, 0.3);
            }
            100% {
                box-shadow: 0 0 5px rgba(255, 255, 255, 0.3);
            }
        }
        
        @keyframes rippleEffect {
            0% {
                transform: scale(0.5);
                opacity: 0.7;
            }
            100% {
                transform: scale(1);
                opacity: 0;
            }
        }

        /* Icons */
        .icon {
            display: inline-block;
            width: 24px;
            height: 24px;
        }

        /* Responsive adjustments */
        @media (max-width: 768px) {
            h1 {
                font-size: 2.5rem;
            }
            
            .subtitle {
                font-size: 1.2rem;
                margin-bottom: 30px;
            }
            
            .buttons {
                flex-direction: column;
                align-items: center;
            }
            
            .card {
                padding: 40px 20px;
            }
        }
    </style>
</head>
<body>
    <div class="background">
        <div class="circle circle1"></div>
        <div class="circle circle2"></div>
        <div class="circle circle3"></div>
    </div>

    <div class="container">
        <div class="card">
            <h1>Welcome to Foodies Restaurant</h1>
            <p class="subtitle">Experience the exquisite flavors of gourmet cuisine</p>
            
            <div class="buttons">
                <a href="/login" class="btn btn-login">
                    <span class="icon">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4M10 17l5-5-5-5M13.8 12H3"/>
                        </svg>
                    </span>
                    Login
                </a>
                <a href="/register" class="btn btn-signup">
                    <span class="icon">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                            <circle cx="8.5" cy="7" r="4"></circle>
                            <line x1="20" y1="8" x2="20" y2="14"></line>
                            <line x1="23" y1="11" x2="17" y2="11"></line>
                        </svg>
                    </span>
                    Create Account
                </a>
            </div>
        </div>
    </div>

    <script>
        // Animate background circles
        document.addEventListener('DOMContentLoaded', function() {
            const circles = document.querySelectorAll('.circle');
            
            circles.forEach((circle, index) => {
                // Random animation duration between 20-40s
                const duration = 20 + Math.random() * 20;
                // Random delay
                const delay = index * 2;
                
                circle.style.animation = `float ${duration}s ease-in-out ${delay}s infinite alternate`;
            });
            
            // Add glow effect to buttons on mouseover for extra interactivity
            const buttons = document.querySelectorAll('.btn');
            buttons.forEach(button => {
                button.addEventListener('mouseover', function() {
                    this.style.boxShadow = this.classList.contains('btn-login') ? 
                        '0 0 25px rgba(255, 120, 0, 0.8), 0 0 40px rgba(255, 120, 0, 0.4)' : 
                        '0 0 25px rgba(255, 255, 255, 0.7), 0 0 40px rgba(255, 255, 255, 0.3)';
                });
                
                button.addEventListener('mouseout', function() {
                    this.style.boxShadow = '';
                });
            });
        });

        // Add floating animation
        document.styleSheets[0].insertRule(`
            @keyframes float {
                0% { transform: translate(0, 0) rotate(0deg); }
                25% { transform: translate(5%, 5%) rotate(5deg); }
                50% { transform: translate(-5%, 10%) rotate(-5deg); }
                75% { transform: translate(10%, -5%) rotate(10deg); }
                100% { transform: translate(-10%, -10%) rotate(-10deg); }
            }
        `, document.styleSheets[0].cssRules.length);
    </script>
</body>
</html>