        <div class="form-container">
            <form action="/reservation" method="POST">

                <div class="form-row">
                    <div class="form-group">
                        <label for="fullName">Full Name</label>
                        <input type="text" id="fullName" name="fullName">
                    </div>
                    
                    <div class="form-group">
